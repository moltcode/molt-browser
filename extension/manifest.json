{
  "manifest_version": 3,
  "name": "Molt Code Browser",
  "short_name": "Molt",
  "version": "0.3.0",
  "description": "Lets your Molt Code agents drive and debug tabs in this browser, with a visible cursor and a Stop button.",
  "key": "",
  "minimum_chrome_version": "137",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Molt Code",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
